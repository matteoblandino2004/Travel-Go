# Travel-Go configuration. Copy to .env and fill in what you have.
# Nothing here is required - with no keys at all the app runs on generated
# sample data.

# ---------------------------------------------------------------------------
# Flight inventory. Pick one; if several are set, TRAVELGO_FLIGHT_PROVIDER
# decides. A and B quote cash fares; C quotes award space in miles, which is a
# different question - so C is never picked automatically over A or B.
# ---------------------------------------------------------------------------

# Option A - Google Flights, via SerpApi. Returns the same options you'd see in
# the browser. Paid, and it works by scraping Google. https://serpapi.com/
# SERPAPI_API_KEY=

# Option B - Amadeus Self-Service. Licensed GDS inventory with a free tier.
# Coverage differs from Google (some low-cost carriers are missing) but the
# offers are real and bookable. https://developers.amadeus.com/
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_ENV=test          # "test" (default) or "production"

# Option C - seats.aero Partner API. Award availability: what a seat costs in
# miles from each mileage programme, plus the cash taxes. Needs a paid Pro
# plan. https://developers.seats.aero/
# SEATSAERO_API_KEY=

# How a mile is valued when an award seat is ranked against the cost criterion.
# An award ticket's cash outlay is only its taxes, so ranking on that alone
# would make a 120,000-mile seat look nearly free. Default 1.4 cents.
# SEATSAERO_CENTS_PER_MILE=1.4

# Cached search carries no times, so each shortlisted result costs one extra
# call to resolve into a real itinerary. This caps how many. Default 15.
# SEATSAERO_TRIP_LIMIT=15

# Restrict to particular mileage programmes or marketing carriers.
# SEATSAERO_SOURCES=aeroplan,united,virginatlantic
# SEATSAERO_CARRIERS=AC,UA,NH

# seats.aero returns taxes as an integer and does not document the unit. They
# are read as minor units (5600 -> $56.00). Set false if they arrive as whole
# currency units instead.
# SEATSAERO_TAXES_IN_CENTS=true

# Force a specific provider: google-flights | amadeus | seatsaero | sample
# TRAVELGO_FLIGHT_PROVIDER=

# ---------------------------------------------------------------------------
# Hotels. Amadeus Hotel Search uses the same credentials as flights above and
# covers the whole world; without it, hotels are generated around the city
# centre for whatever destination you search.
# ---------------------------------------------------------------------------

# Force a specific provider: amadeus | sample
# TRAVELGO_HOTEL_PROVIDER=

# ---------------------------------------------------------------------------
# Geocoding - turns "Torre de Belem" into coordinates, for any city.
# Defaults to Nominatim (OpenStreetMap): free, keyless, rate-limited to one
# request a second. Set TRAVELGO_GEOCODER=none to disable it, in which case
# only the curated places for catalogued cities resolve.
# ---------------------------------------------------------------------------

# TRAVELGO_GEOCODER=nominatim
# NOMINATIM_URL=https://nominatim.openstreetmap.org   # or your own instance
# GEOCODER_USER_AGENT=my-app/1.0 (contact@example.com)

# ---------------------------------------------------------------------------
# Plain-English trip intake. Without a key, an offline keyword parser is used.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=

# PORT=3000
