# Travel-Go configuration. Copy to .env and fill in what you have.
# Nothing here is required - with no keys at all the app runs on generated
# sample data.

# ---------------------------------------------------------------------------
# Flight inventory. Pick one; if both are set, TRAVELGO_FLIGHT_PROVIDER decides.
# ---------------------------------------------------------------------------

# Option A - Google Flights, via SerpApi. Returns the same options you'd see in
# the browser. Paid, and it works by scraping Google. https://serpapi.com/
# SERPAPI_API_KEY=

# Option B - Amadeus Self-Service. Licensed GDS inventory with a free tier.
# Coverage differs from Google (some low-cost carriers are missing) but the
# offers are real and bookable. https://developers.amadeus.com/
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_ENV=test          # "test" (default) or "production"

# Force a specific provider: google-flights | amadeus | sample
# TRAVELGO_FLIGHT_PROVIDER=

# ---------------------------------------------------------------------------
# Plain-English trip intake. Without a key, an offline keyword parser is used.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=

# PORT=3000
