{
  "name": "travel-go",
  "version": "0.1.0",
  "description": "Preference-ranked travel search: rank flights and hotels against importance weights you set yourself.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server/server.js",
    "test": "node --test",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "build:standalone": "node scripts/build-standalone.mjs"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.124.0"
  },
  "license": "MIT"
}
